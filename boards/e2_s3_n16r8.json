{
  "name": "E2 HW2.0 ESP32-S3 N16R8",
  "vendor": "Custom",
  "url": "https://github.com/janhavelka/ESS23-RS",
  "build": {
    "mcu": "esp32s3",
    "core": "esp32",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "psram_type": "opi",
    "arduino": { "memory_type": "qio_opi" },
    "extra_flags": ["-DARDUINO_ESP32S3_DEV", "-DBOARD_HAS_PSRAM"],
    "hwids": [["0x303A", "0x1001"]]
  },
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 8323072,
    "require_upload_port": true,
    "speed": 921600
  }
}
